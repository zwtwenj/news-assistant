# ===== 应用 =====
APP_NAME=news-assistant
ENV=dev
# openssl rand -hex 32 生成，prod 必须更换
SECRET_KEY=change-me
CORS_ORIGINS=["http://localhost:3000"]

# ===== 基础设施（本地 docker compose up -d 即可）=====
DATABASE_URL=postgresql+psycopg://news:news@localhost:5432/news
REDIS_URL=redis://localhost:6379/0

# ===== 短信（阿里云 号码认证服务 PNVS 短信认证）=====
# mock=开发用（验证码走 Redis）| aliyun=PNVS 真实发送（个人实名可用）
SMS_PROVIDER=mock
SMS_ALIYUN_AK=
SMS_ALIYUN_SECRET=
SMS_SIGN_NAME=
SMS_TEMPLATE_CODE=


# ===== LLM providers（OpenAI 兼容）=====
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
ZHIPU_API_KEY=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimaxi.com/v1

# ===== Langfuse（LLM 观测，自托管）=====
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# ===== 向量库 =====
MILVUS_URI=
MILVUS_TOKEN=

# ===== 播客合成 =====
# Windows 本地开发可填 ffmpeg.exe 绝对路径（缺省回退 imageio-ffmpeg / PATH）
FFMPEG_PATH=ffmpeg
# 本地暂存根（生成中分段 wav 与拼接 mp3；上传 OSS 后清理）
MEDIA_DIR=media
PODCAST_TTS_ENABLED=true

# ===== 阿里云 OSS（播客音频终存）=====
# AK 为空时回退本地 /media；bucket 需公共读（audio_url 存公有直链）
OSS_ACCESS_KEY_ID=
OSS_SECRET=
OSS_BUCKET=icarus1
OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
OSS_PREFIX=news/podcasts
