# ===== 生产环境配置（复制为 deploy/.env，由 deploy.sh 与 compose 注入）=====
# 生成强密码：openssl rand -hex 16

# 应用
APP_NAME=news-assistant
ENV=prod
SECRET_KEY=<openssl rand -hex 32>
CORS_ORIGINS=["http://198.44.177.247:8080"]
# 当前 HTTP 直连 IP：必须 false；将来上域名+HTTPS 后改 true
COOKIE_SECURE=false

# 基础设施（容器网络内走服务名）
DATABASE_URL=postgresql+psycopg://news:<POSTGRES_PASSWORD>@postgres:5432/news
REDIS_URL=redis://:<REDIS_PASSWORD>@redis:6379/0

# compose 插值用（PG 容器密码 / Redis requirepass，与上面 URL 中一致）
POSTGRES_PASSWORD=
REDIS_PASSWORD=

# 短信（阿里云 PNVS）
SMS_PROVIDER=aliyun
SMS_ALIYUN_AK=
SMS_ALIYUN_SECRET=
SMS_SIGN_NAME=
SMS_TEMPLATE_CODE=

# LLM providers
DEEPSEEK_API_KEY=
ZHIPU_API_KEY=
DASHSCOPE_API_KEY=
MINIMAX_API_KEY=

# Langfuse
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# 向量库
MILVUS_URI=
MILVUS_TOKEN=

# 播客 / OSS
PODCAST_TTS_ENABLED=true
OSS_ACCESS_KEY_ID=
OSS_SECRET=
OSS_BUCKET=icarus1
OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
OSS_PREFIX=news/podcasts
